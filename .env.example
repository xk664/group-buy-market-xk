# ============ AI 客服 RAG 环境变量示例 ============
# 用法：复制本文件为 .env 或配置到系统环境变量；值为占位符/示例，按实际填写

# PostgreSQL（云端，需启用 vector 扩展；建议独立库 group_buy_market_ai）
AI_DB_URL=jdbc:postgresql://<你的云PG主机>:5432/group_buy_market_ai
AI_DB_USERNAME=postgres
AI_DB_PASSWORD=<你的PG密码>

# 对话 LLM（OpenAI 兼容）
AI_CHAT_BASE_URL=https://ws-fjail6hets52nr17.cn-beijing.maas.aliyuncs.com/api/v1
AI_CHAT_API_KEY=sk-<你的对话LLM密钥>
AI_CHAT_MODEL=deepseek-v4-flash

# Embedding（独立地址/Key，可选；不填则复用对话配置）
AI_EMBEDDING_BASE_URL=https://ws-fjail6hets52nr17.cn-beijing.maas.aliyuncs.com/api/v1
AI_EMBEDDING_API_KEY=sk-ws-<你的embedding密钥>
AI_EMBEDDING_MODEL=text-embedding-v1

# 知识语料根目录（模拟语料已就位）
AI_KNOWLEDGE_PATH=./knowledge