# ============ AI 客服 RAG 环境变量示例 ============
# 用法：复制本文件为 .env 或配置到系统环境变量；所有值均为占位符，按实际填写

# PostgreSQL（云端，需启用 vector 扩展；建议独立库 group_buy_market_ai）
AI_DB_URL=jdbc:postgresql://<你的云PG主机>:5432/group_buy_market_ai
AI_DB_USERNAME=postgres
AI_DB_PASSWORD=<你的PG密码>

# 云端 LLM（DashScope OpenAI 兼容模式）
# 注意：AI_LLM_API_KEY 留空时，系统自动启用 Mock 实现（仅本地联调，不调真实模型）
AI_LLM_API_KEY=sk-<你的DashScope密钥>
AI_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CHAT_MODEL=qwen-plus
AI_EMBEDDING_MODEL=text-embedding-v3

# 知识语料根目录（模拟语料已就位）
AI_KNOWLEDGE_PATH=./knowledge